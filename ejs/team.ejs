```{=html}
<%
  // Team page — members grouped by `group` (see team/members.yml for the list of groups).
  const GROUPS = ['Group lead', 'Senior scientists', 'Postdoctoral researchers', 'PhD students',
                  'Research staff', 'Student assistants & interns', 'Alumni'];
  const initials = n => String(n || '').replace(/(Prof\.|Dr\.|M\.Sc\.|B\.Sc\.|PhD|,)/g, '').trim()
                     .split(/\s+/).filter(Boolean).map(w => w[0]).filter((c, i, a) => i === 0 || i === a.length - 1).join('');
  const byGroup = {};
  items.forEach(m => { const g = m.group || 'Research staff'; (byGroup[g] = byGroup[g] || []).push(m); });
  const order = GROUPS.concat(Object.keys(byGroup).filter(g => !GROUPS.includes(g)));
%>
<% order.forEach(g => { const list = byGroup[g]; if (!list) return; list.sort((a, b) => (a.order || 99) - (b.order || 99)); %>
<section class="team-group" aria-labelledby="tg-<%= g.replace(/\W+/g, '-').toLowerCase() %>">
  <h3 id="tg-<%= g.replace(/\W+/g, '-').toLowerCase() %>"><%= g %></h3>
  <div class="team-grid">
  <% list.forEach(m => { %>
    <article class="member">
      <div class="ph">
        <% if (m.photo) { %><img src="<%- m.photo %>" alt="Portrait of <%= m.short || m.name %>" loading="lazy"><% } else { %><span class="initials" aria-hidden="true"><%= initials(m.short || m.name) %></span><% } %>
      </div>
      <h4 class="nm"><% if (m.page) { %><a href="<%- m.page %>"><%= m.name %></a><% } else { %><%= m.name %><% } %></h4>
      <div class="rl"><%= m.role %></div>
      <% if (m.bio) { %><p class="bio"><%= m.bio %></p><% } %>
      <div class="links">
        <% if (m.page) { %><a class="tagpill" href="<%- m.page %>">Profile</a><% } %>
        <% if (m.email) { %><a class="tagpill" href="mailto:<%- m.email %>" aria-label="Email <%= m.short || m.name %>"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</a><% } %>
        <% if (m.orcid) { %><a class="tagpill" href="<%- m.orcid %>" aria-label="ORCID of <%= m.short || m.name %>"><i class="fa-brands fa-orcid" aria-hidden="true"></i> ORCID</a><% } %>
        <% if (m.scholar) { %><a class="tagpill" href="<%- m.scholar %>" aria-label="Google Scholar profile of <%= m.short || m.name %>"><i class="ai ai-google-scholar" aria-hidden="true"></i> Scholar</a><% } %>
        <% if (m.github) { %><a class="tagpill" href="<%- m.github %>"><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a><% } %>
        <% if (m.website) { %><a class="tagpill" href="<%- m.website %>">Website</a><% } %>
        <% if (m.zalf_profile) { %><a class="tagpill" href="<%- m.zalf_profile %>" aria-label="ZALF profile of <%= m.short || m.name %>">ZALF profile</a><% } %>
      </div>
    </article>
  <% }) %>
  </div>
</section>
<% }) %>
```
