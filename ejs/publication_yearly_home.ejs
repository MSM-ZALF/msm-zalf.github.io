```{=html}
<%
  // Compact publication rows for the home page (no filters).
  // Group members' names are highlighted (the regex needs ONE capture group so split() keeps the matches) — keep this list in sync with
  // MEMBER_NAMES in ejs/publication_filter.ejs.
  const MEMBER_NAMES = /(Srivastava, A\.(?:\s?K\.?)?|Ewert, F\.)/g;
  let sorted = items.slice().sort((a, b) => {
    let ya = String(a.year || ''); let yb = String(b.year || '');
    let ra = ya.toLowerCase() === 'in review'; let rb = yb.toLowerCase() === 'in review';
    if (ra && !rb) return -1; if (!ra && rb) return 1;
    let na = parseInt(ya); let nb = parseInt(yb);
    if (!isNaN(na) && !isNaN(nb)) return nb - na;
    return yb.localeCompare(ya);
  });
  const esc = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
%>
<div class="pub-list">
<% for (let i = 0; i < sorted.length; i++) { let item = sorted[i]; %>
  <article class="pub">
    <div class="yr"><%= item.year || '' %></div>
    <div class="meta">
      <div class="pt"><%= item.title %></div>
      <div class="pj">
        <i><%= item.journal %></i><% if (item.authors) { %> · <% String(item.authors).split(MEMBER_NAMES).forEach((part, k) => { if (k % 2) { %><span class="author-name"><%= part %></span><% } else { %><%= part %><% } }) %><% } %>
      </div>
      <div class="links">
        <% if (item.doi) { %><a class="tagpill" href="<%- item.doi %>" aria-label="DOI: <%= item.title %>">DOI</a><% } %>
        <% if (item.url) { %><a class="tagpill" href="<%- item.url %>">Link</a><% } %>
        <% if (item.preprint_url) { %><a class="tagpill" href="<%- item.preprint_url %>">Preprint</a><% } %>
        <% if (item.data_url) { %><a class="tagpill" href="<%- item.data_url %>">Data</a><% } %>
        <% if (item.code_url) { %><a class="tagpill" href="<%- item.code_url %>">Code</a><% } %>
      </div>
    </div>
  </article>
<% } %>
</div>
```
