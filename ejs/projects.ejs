```{=html}
<%
  // Projects page: ongoing projects as cards, completed projects as a table,
  // long-term networks as cards. Status is derived from `end` (YYYY-MM | YYYY | present).
  const now = new Date();
  const endDate = e => {
    if (!e || String(e).toLowerCase() === 'present') return null;
    const [y, m] = String(e).split('-').map(Number);
    return m ? new Date(y, m, 0, 23, 59) : new Date(y, 11, 31, 23, 59);   // last day of month / year
  };
  const fmt = d => { if (!d) return ''; if (String(d).toLowerCase() === 'present') return 'present';
                     const [y, m] = String(d).split('-'); return m ? m + '/' + y : y; };
  const span = p => { const a = fmt(p.start), b = fmt(p.end); return (a && b && a !== b) ? a + ' – ' + b : (a || b); };
  const isOngoing = p => { const e = endDate(p.end); return e === null || e >= now; };
  const projects = items.filter(p => (p.kind || 'project') === 'project');
  const networks = items.filter(p => p.kind === 'network');
  const ongoing = projects.filter(isOngoing);
  const completed = projects.filter(p => !isOngoing(p))
                            .sort((a, b) => (endDate(b.end) || 0) - (endDate(a.end) || 0));
%>
<div class="section-head"><h2 id="ongoing">Ongoing projects</h2></div>
<div class="proj-grid">
<% ongoing.forEach(p => { %>
  <article class="proj" data-end="<%= p.end %>">
    <div class="top"><h3 class="acr"><%= p.acronym %></h3><span class="status ongoing">Ongoing</span></div>
    <p class="ttl"><%= p.title %></p>
    <dl>
      <% if (span(p)) { %><dt>Duration</dt><dd><%= span(p) %></dd><% } %>
      <% if (p.funder) { %><dt>Funder</dt><dd><%= p.funder %></dd><% } %>
      <% if (p.role) { %><dt>MSM role</dt><dd><%= p.role %></dd><% } %>
      <% if (p.funding) { %><dt>Acquired</dt><dd><%= p.funding %></dd><% } %>
    </dl>
    <% if (p.url) { %><div class="links"><a class="tagpill" href="<%- p.url %>">Project website</a></div><% } %>
  </article>
<% }) %>
</div>

<div class="section-head" style="margin-top:4rem"><h2 id="networks">Collaborations &amp; networks</h2></div>
<div class="proj-grid">
<% networks.forEach(p => { %>
  <article class="proj">
    <div class="top"><h3 class="acr"><%= p.acronym %></h3><% if (span(p)) { %><span class="status ongoing"><%= span(p) %></span><% } %></div>
    <p class="ttl"><%= p.title %></p>
    <dl>
      <% if (p.funder) { %><dt>Context</dt><dd><%= p.funder %></dd><% } %>
      <% if (p.role) { %><dt>MSM role</dt><dd><%= p.role %></dd><% } %>
    </dl>
    <% if (p.url) { %><div class="links"><a class="tagpill" href="<%- p.url %>">Website</a></div><% } %>
  </article>
<% }) %>
</div>

<div class="section-head" style="margin-top:4rem"><h2 id="completed">Completed projects</h2></div>
<p class="msm-prose" style="margin-top:-1rem">Includes projects that group members led or contributed to before joining ZALF (University of Bonn; European Commission Joint Research Centre).</p>
<div class="proj-table-wrap">
<table class="proj-table">
  <caption class="visually-hidden">Completed projects with duration, funder, role and acquired funding</caption>
  <thead><tr><th scope="col">Project</th><th scope="col">Duration</th><th scope="col">Funder</th><th scope="col">Role</th><th scope="col">Acquired</th></tr></thead>
  <tbody>
  <% completed.forEach(p => { %>
    <tr>
      <td class="acr"><% if (p.url) { %><a href="<%- p.url %>"><%= p.acronym %></a><% } else { %><%= p.acronym %><% } %><div class="ttl" style="font-weight:400;white-space:normal;max-width:46ch"><%= p.title %></div></td>
      <td class="when"><%= span(p) %></td>
      <td><%= p.funder || '' %></td>
      <td><%= p.role || '' %></td>
      <td><%= p.funding || '' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<p class="msm-note">Acquired funding is shown as stated in the project records (currency given where specified).</p>
```

<script>
  // Re-check status in the browser so a project whose end date has passed since the last build is labelled correctly.
  (function () {
    var now = new Date();
    document.querySelectorAll('.proj[data-end]').forEach(function (el) {
      var e = el.dataset.end; if (!e || e === 'present') return;
      var p = e.split('-').map(Number), d = p[1] ? new Date(p[0], p[1], 0, 23, 59) : new Date(p[0], 11, 31, 23, 59);
      if (d < now) { var s = el.querySelector('.status'); if (s) { s.textContent = 'Completed'; s.className = 'status completed'; } }
    });
  })();
</script>
