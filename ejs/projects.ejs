```{=html}
<%
  // Projects page — approved projects only (see projects/projects.yml).
  // Status: Starting (start in future) · Ongoing · Completed (end passed) · Approved (no dates)
  const now = new Date();
  const toDate = (v, endOfPeriod) => {
    if (!v || String(v).toLowerCase() === 'present') return null;
    const [y, m] = String(v).split('-').map(Number);
    return endOfPeriod ? (m ? new Date(y, m, 0, 23, 59) : new Date(y, 11, 31, 23, 59)) : new Date(y, (m || 1) - 1, 1);
  };
  const fmt = d => { if (!d) return ''; const [y, m] = String(d).split('-'); return m ? m + '/' + y : y; };
  const span = p => { const a = fmt(p.start), b = fmt(p.end); return (a && b && a !== b) ? a + ' – ' + b : (a || b); };
  const status = p => {
    const s = toDate(p.start, false), e = toDate(p.end, true);
    if (!s && !e) return ['approved', 'Approved'];
    if (s && s > now) return ['starting', 'Starting ' + fmt(p.start)];
    if (e && e < now) return ['completed', 'Completed'];
    return ['ongoing', 'Ongoing'];
  };
  const rank = { ongoing: 0, starting: 1, approved: 2, completed: 3 };
  const list = items.slice().sort((a, b) => rank[status(a)[0]] - rank[status(b)[0]] || ((toDate(b.start) || 0) - (toDate(a.start) || 0)));
  const eur = n => (typeof n === 'number' || /^\d+(\.\d+)?$/.test(String(n))) ? '€' + Math.round(Number(n)).toLocaleString('en-GB') : String(n || '');
%>
<div class="msm-stats" style="margin:0 0 2.4rem">
  <div class="msm-stat"><div class="n"><%= items.length %></div><div class="l">approved projects</div></div>
  <div class="msm-stat"><div class="n"><%= list.filter(p => status(p)[0] === 'ongoing').length %></div><div class="l">currently running</div></div>
</div>
<div class="proj-grid">
<% list.forEach(p => { const st = status(p); %>
  <article class="proj" data-start="<%= p.start || '' %>" data-end="<%= p.end || '' %>">
    <div class="top"><h3 class="acr"><%= p.acronym %></h3><span class="status <%= st[0] %>"><%= st[1] %></span></div>
    <p class="ttl"><%= p.title %></p>
    <dl>
      <% if (span(p)) { %><dt>Duration</dt><dd><%= span(p) %></dd><% } %>
      <% if (p.funder) { %><dt>Funder</dt><dd><%= p.funder %></dd><% } %>
      <% if (p.call) { %><dt>Call</dt><dd><%= p.call %></dd><% } %>
      <% if (p.partners) { %><dt>Consortium</dt><dd><%= p.partners %></dd><% } %>
      <% if (p.role) { %><dt>MSM role</dt><dd><%= p.role %></dd><% } %>
      <% if (p.positions) { %><dt>Positions</dt><dd><%= p.positions %></dd><% } %>
      <% if (p.funding) { %><dt>Funding</dt><dd><%= eur(p.funding) %></dd><% } %>
    </dl>
    <% if (p.url) { %><div class="links"><a class="tagpill" href="<%- p.url %>">Project website</a></div><% } %>
  </article>
<% }) %>
</div>
<p class="msm-note">Funding: third-party funds acquired for MSM in each project (EUR). Only approved projects are listed.</p>
```

<script>
  // Re-check status in the visitor's browser so labels stay correct between weekly rebuilds.
  (function () {
    var now = new Date();
    function d(v, end) { if (!v) return null; var p = v.split('-').map(Number);
      return end ? (p[1] ? new Date(p[0], p[1], 0, 23, 59) : new Date(p[0], 11, 31, 23, 59)) : new Date(p[0], (p[1] || 1) - 1, 1); }
    document.querySelectorAll('.proj[data-end]').forEach(function (el) {
      var s = d(el.dataset.start, false), e = d(el.dataset.end, true), b = el.querySelector('.status');
      if (!b || (!s && !e)) return;
      if (e && e < now) { b.textContent = 'Completed'; b.className = 'status completed'; }
      else if (s && s <= now && b.classList.contains('starting')) { b.textContent = 'Ongoing'; b.className = 'status ongoing'; }
    });
  })();
</script>
